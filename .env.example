# Names only. Real values live in OS keychain (laptop) or Worker secrets/KV (relay).
# Never commit a real .env.

# Cloudflare (laptop side uses wrangler OAuth session, not a token file)
CLOUDFLARE_ACCOUNT_ID=

# Supabase (used once for migrations from laptop session env, then discarded)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Meta / Instagram (stored as Worker secrets / KV; laptop never holds them)
META_APP_ID=
META_APP_SECRET=
IG_USER_ID=
IG_ACCESS_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM / media keys (laptop OS keychain only)
GEMINI_API_KEY=
GROQ_API_KEY=
PEXELS_API_KEY=

# YouTube (Worker secrets or private-repo Actions secrets)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Factory API (Worker secret + laptop OS keychain)
FACTORY_API_KEY=
FACTORY_HMAC_SECRET=

# Optional
WHATSAPP_CHANNEL_URL=
AMAZON_ASSOCIATE_TAG=
COLLAB_USERNAMES=
GITHUB_PRIVATE_REPO=